{
  "name": "Default Account for Google™ products",
  "description": "Select and manage your default account for 🎥 Google Meet™, 📩 Gmail™, or any other product.",
  "version": "2.0",
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "switch_to_ga_1": {
      "suggested_key": {
        "default": "Alt+1",
        "mac": "MacCtrl+Shift+1"
      },
      "description": "Switch to Google™ Account #1"
    },
    "switch_to_ga_2": {
      "suggested_key": {
        "default": "Alt+2",
        "mac": "MacCtrl+Shift+2"
      },
      "description": "Switch to Google™ Account #2"
    },
    "switch_to_ga_3": {
      "suggested_key": {
        "default": "Alt+3",
        "mac": "MacCtrl+Shift+3"
      },
      "description": "Switch to Google™ Account #3"
    },
    "switch_to_ga_4": {
      "suggested_key": {
        "default": "Alt+4",
        "mac": "MacCtrl+Shift+4"
      },
      "description": "Switch to Google™ Account #4"
    },
    "switch_to_ga_5": {
      "description": "Switch to Google™ Account #5"
    },
    "switch_to_ga_6": {
      "description": "Switch to Google™ Account #6"
    },
    "switch_to_ga_7": {
      "description": "Switch to Google™ Account #7"
    },
    "switch_to_ga_8": {
      "description": "Switch to Google™ Account #8"
    },
    "switch_to_ga_9": {
      "description": "Switch to Google™ Account #9"
    }
  },
  "icons": {
    "16": "/images/16.png",
    "32": "/images/32.png",
    "48": "/images/48.png",
    "128": "/images/128.png"
  }
}
