{
  "manifest_version": 2,
  "name": "Default Account for Google™ products",
  "description": "Select and manage your default account for Google Meet™, Gmail™, YouTube™, or any other Google™ product.",
  "version": "2.0",
  "icons": {
    "16": "/images/16.png",
    "32": "/images/32.png",
    "48": "/images/48.png",
    "128": "/images/128.png"
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["utils.js", "service-worker.js"],
    "persistent": false
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "*://*.google.com/*",
    "*://*.youtube.com/*",
    "*://*.blogger.com/*",
    "*://*.blogspot.com/*"
  ],
  "commands": {
    "switch_to_ga_1": { "description": "Switch to Google™ Account #1", "suggested_key": { "default": "Alt+1" } },
    "switch_to_ga_2": { "description": "Switch to Google™ Account #2", "suggested_key": { "default": "Alt+2" } },
    "switch_to_ga_3": { "description": "Switch to Google™ Account #3", "suggested_key": { "default": "Alt+3" } },
    "switch_to_ga_4": { "description": "Switch to Google™ Account #4", "suggested_key": { "default": "Alt+4" } },
    "switch_to_ga_5": { "description": "Switch to Google™ Account #5" },
    "switch_to_ga_6": { "description": "Switch to Google™ Account #6" },
    "switch_to_ga_7": { "description": "Switch to Google™ Account #7" },
    "switch_to_ga_8": { "description": "Switch to Google™ Account #8" },
    "switch_to_ga_9": { "description": "Switch to Google™ Account #9" }
  },
  "browser_specific_settings": {
    "gecko": { "strict_min_version": "109.0" }
  }
}
